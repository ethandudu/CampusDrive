# CampusDrive configuration, read by docker-compose.yaml and app/utils/config.php.
# Copy to .env and fill in the values:  cp .env.example .env
# Quote a value with single quotes if it contains spaces, # or $.

# --- MariaDB ---
# MariaDB only applies these credentials when its data volume is first created.
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_HOST=mariadb
MYSQL_DATABASE=campusdrive
MYSQL_USER=campususer
MYSQL_PASSWORD=change-me

# --- Mail (SMTP) ---
MAIL_HOST=ssl0.ovh.net
MAIL_USERNAME=noreply@campusdrive.fr
MAIL_PASSWORD=change-me
MAIL_FROM=noreply@campusdrive.fr
MAIL_FROM_NAME=CampusDrive

# --- Application ---
APP_BASE_URL=https://campusdrive.fr
# Comma-separated list of email domains allowed to register.
UNIVERSITY_EMAIL_DOMAINS=
ADMIN_EMAIL=

# --- Optional (leave empty to use the default) ---
# Folder where uploaded files are stored (default: /var/www/uploads).
UPLOAD_DIR=
# true/false: force the Secure flag on the session cookie. By default it is enabled when the request is
# served over HTTPS (or behind a proxy sending X-Forwarded-Proto: https). Set to true in production.
SESSION_COOKIE_SECURE=
# Comma-separated IP addresses or CIDR ranges of reverse proxies whose X-Forwarded-For header can be trusted
# when logging the client IP. Leave empty if the app is not behind a proxy.
TRUSTED_PROXIES=
# true/false: set to true when the app is served through Cloudflare. CF-Connecting-IP is then used for the
# logged IP, but only for requests coming from Cloudflare's IP ranges (or from a TRUSTED_PROXIES entry).
BEHIND_CLOUDFLARE=

# --- ClamAV antivirus ---
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
# Scan timeout in seconds (1-300).
CLAMAV_TIMEOUT=45
