{
    "name": "campusdrive/app",
    "description": "CampusDrive application",
    "type": "project",
    "license": "AGPL-3.0",
    "version": "1.4.0",
    "require": {
        "php": ">=8.5",
        "phpmailer/phpmailer": "^7.1",
        "twbs/bootstrap": "5.3.8",
        "ext-fileinfo": "*",
        "ext-pdo": "*",
        "ext-mbstring": "*"
    },
    "config": {
        "optimize-autoloader": true
    },
    "autoload": {
        "psr-4": {
            "CampusDrive\\Infrastructure\\Database\\": "src/Infrastructure/Database/",
            "CampusDrive\\Infrastructure\\Security\\": "src/Infrastructure/Security/",
            "CampusDrive\\Infrastructure\\Session\\": "src/Infrastructure/Session/",
            "CampusDrive\\Infrastructure\\Storage\\": "src/Infrastructure/Storage/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^11"
    },
    "scripts": {
        "publish-assets": "@php scripts/publish-assets.php",
        "post-install-cmd": "@publish-assets",
        "post-update-cmd": "@publish-assets",
        "test": "phpunit"
    }
}
